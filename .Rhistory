library(shiny)
library(jsonlite)
source("R/ingest.R")
source("R/decode.R")
source("R/templates.R")
DICTS <- load_dictionaries("data/var_key.csv", "data/value_labels.csv")
ui <- fluidPage(
tags$head(
tags$script(src = "typst-bridge.js", type = "module"),
tags$style(HTML("
body { max-width: 46rem; margin: 0 auto; padding: 2rem 1.25rem 4rem;
font-family: system-ui, sans-serif; color: #1a1a1a; }
h1 { font-size: 1.4rem; margin-bottom: .25rem; }
.lede { color: #4d4d4d; margin-bottom: 1.75rem; line-height: 1.5; }
.panel { border: 1px solid #d8d8d8; border-radius: 6px;
padding: 1.1rem 1.25rem; margin-bottom: 1.1rem; }
.problem { border-left: 3px solid #b3261e; background: #fdf5f4; }
.ready { border-left: 3px solid #1f4e5f; background: #f4f8f9; }
#status { font-variant-numeric: tabular-nums; color: #4d4d4d; }
"))
),
h1("Report Generator"),
p(class = "lede",
"Export your dashboard as a CSV file; drop it below to get an advising report for each student. Your data stays in this browser tab and is never uploaded."),
div(class = "panel",
fileInput("file", "Choose your dashboard export", accept = ".csv",
width = "100%", buttonLabel = "Browse", placeholder = "No file chosen")),
div(class = "panel",
radioButtons("rtype", "Report type",
choices = setNames(names(TEMPLATES),
vapply(TEMPLATES, `[[`, "", "label")),
selected = names(TEMPLATES)[1])),
uiOutput("check"),
div(class = "panel",
actionButton("go", "Generate reports", class = "btn-primary"),
tags$p(id = "status", style = "margin-top:.85rem;"))
)
server <- function(input, output, session) {
upload <- reactive({
req(input$file)
read_upload(input$file$datapath)
})
filtered <- reactive({
u <- upload()
if (!u$ok) return(NULL)
filter_by_type(u$data, input$rtype)
})
output$check <- renderUI({
u <- upload()
if (!u$ok) return(div(class = "panel problem", strong("Problem: "), u$error))
bad <- validate_template_fields(TEMPLATES[[input$rtype]]$fields, DICTS)
if (length(bad) > 0) {
return(div(class = "panel problem", strong("Template error: "),
sprintf("unknown variable(s) %s", paste(bad, collapse = ", "))))
}
f <- filtered()
cls <- if (f$n_kept == 0) "panel problem" else "panel ready"
div(class = cls, tally_message(f, input$rtype))
})
observeEvent(input$go, {
u <- upload()
if (!u$ok) return(showNotification(u$error, type = "error", duration = NULL))
f <- filtered()
if (f$n_kept == 0) {
return(showNotification(tally_message(f, input$rtype),
type = "error", duration = NULL))
}
tpl <- TEMPLATES[[input$rtype]]
msg <- build_compile_message(f$kept, tpl, DICTS, filename_mode = "name")
session$sendCustomMessage("compile_typst", msg)
})
observeEvent(input$compile_result, {
res <- input$compile_result
if (isTRUE(res$ok)) {
msg <- sprintf("Generated %d report(s).", res$n)
if (res$failed > 0) msg <- paste(msg, sprintf("%d failed; see errors.txt in the zip.", res$failed))
showNotification(msg, type = "message")
} else {
showNotification(paste("Generation failed:", res$error), duration = NULL, type = "error")
}
})
}
shinyApp(ui, server)
shinyApp(ui, server)
